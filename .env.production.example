APP_NAME="図書貸出管理システム"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.internal

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# AWS（Fargate）では LOG_CHANNEL=stderr にする。CloudWatch が標準エラーを拾う。
# DB_HOST は RDS のエンドポイント（タスク定義が Secrets Manager から渡す）。

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=company_library
DB_USERNAME=library_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Apache / Nginx のリバースプロキシ背後なら * またはプロキシ IP
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=library@example.internal
MAIL_FROM_NAME="${APP_NAME}"

RETURN_LOCATION_RESTRICTED=true
RETURN_ALLOWED_NETWORKS=192.168.0.0/24
RETURN_LOCATION_NAME=オフィスWi-Fi
RETURN_ALLOW_LOCALHOST=false

INITIAL_PASSWORD=

# 任意。空なら期限切れ Slack は送らない
# SLACK_OVERDUE_WEBHOOK_URL=
# SLACK_BOT_TOKEN=

# 任意。空なら Google Books の無認証枠
# GOOGLE_BOOKS_API_KEY=

# AWS へ載せるときは [docs/AWSセットアップ.md](docs/AWSセットアップ.md)。
# いまの本番は Linux 上のこのファイル（`.env`）が正。CDK は未デプロイ。
