APP_NAME="図書貸出管理システム"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL を使う場合:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=company_library
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# スマホから PC の Vite に繋ぐとき（任意）
# VITE_HMR_HOST=192.168.x.x

# 場所制限。最初は false か、true なら RETURN_ALLOW_LOCALHOST=true
RETURN_LOCATION_RESTRICTED=false
RETURN_ALLOWED_NETWORKS=192.168.0.0/24
RETURN_LOCATION_NAME=開発環境
RETURN_ALLOW_LOCALHOST=true

INITIAL_PASSWORD=password

# 任意。空なら期限切れ Slack は送らない
# SLACK_OVERDUE_WEBHOOK_URL=
# SLACK_BOT_TOKEN=

# 任意。空なら Google Books の無認証枠
# GOOGLE_BOOKS_API_KEY=

# 本サーバー（MySQL + SMTP）のひな形は .env.production.example
# 初回載せ方は docs/本サーバーセットアップ.md
